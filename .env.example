POSTGRES_DB=reflectopatronus
# Bootstrap/admin role used only by PostgreSQL initialization and administration.
POSTGRES_USER=reflectopatronus_admin
POSTGRES_PASSWORD=replace-with-a-long-random-admin-password
# Restricted runtime account used by the API.
APP_DB_USER=reflectopatronus_app
APP_DB_PASSWORD=replace-with-a-different-long-random-app-password
ASPNETCORE_ENVIRONMENT=Development
REQUIRE_PQC_VERIFICATION=false

# First-run admin (remove after the first login)
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=
