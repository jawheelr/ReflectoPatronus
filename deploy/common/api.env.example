# Environment for the API. Docker passes these through docker-compose.yml; LXC loads this file via systemd EnvironmentFile.
# Identical variable names in both -> the application is configured the same way everywhere.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080
Security__RequirePqcVerification=false
# Host=db is a convention shared by both runtimes (compose service name / /etc/hosts entry in the API container),
# so one server certificate (CN/SAN `db`) works unchanged when you move between Docker and LXC.
Database__ConnectionString=Host=db;Port=5432;Database=reflectopatronus;Username=reflectopatronus_app;Password=CHANGE_ME;SSL Mode=VerifyFull;Root Certificate=/etc/reflectopatronus/pki/ca.crt;SSL Certificate=/etc/reflectopatronus/pki/api-client.crt;SSL Key=/etc/reflectopatronus/pki/api-client.key;Timeout=8;Command Timeout=15;GSS Encryption Mode=Disable;
