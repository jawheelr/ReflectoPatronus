# Preseed for the LXC template's first-time setup. Copy, edit, and put it in the new container as /root/rp-preseed.env:
#   pct push <ctid> preseed.env /root/rp-preseed.env --perms 0600      (or: pct-create.sh ... --preseed preseed.env)
# The wizard uses it automatically (no banner, no confirmation if nothing is missing), then deletes it.
# Anything you leave out is asked for on the console, or generated where noted.
RP_ROLE=all                      # all | db | api

# REQUIRED for roles all/api. There is no default login: you choose it. Password: 12+ chars, none of ; ' " \ $ or space.
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=

# Remote access gateway (client-certificate mTLS + post-quantum TLS), roles all/api. Listens on its own port.
#RP_GATEWAY=y
#GATEWAY_HOSTNAMES=rp.example.net      # what clients connect to (comma separated names/IPs)
#GATEWAY_PORT=8443                     # forward this TCP port on your router; 80/443 stay untouched
#RP_DEVICE_NAME=my-ipad                # also issue a first device certificate

# Optional (generated when omitted, and shown once on the console + saved in /root/rp.env)
#POSTGRES_PASSWORD=
#APP_DB_PASSWORD=
# Optional (defaults in brackets)
#POSTGRES_DB=reflectopatronus
#POSTGRES_USER=reflectopatronus_admin
#APP_DB_USER=reflectopatronus_app
#LISTEN_ADDRESSES=              # role db only [container IP]
#DB_IP=                         # role api only (required): address of the database container
# Your own certificates instead of generated ones: a directory INSIDE the container holding
#   all: ca.crt server.crt server.key api-client.crt api-client.key | db: ca.crt server.crt server.key | api: ca.crt api-client.crt api-client.key
#RP_PKI_DIR=/root/my-certs
